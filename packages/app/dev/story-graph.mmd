%%{init: {'flowchart': {'curve': 'linear'}}}%%
graph TD;
	__start__([<p>__start__</p>]):::first
	understand(understand)
	askQuestion(askQuestion)
	castCharacters(castCharacters)
	designVoices(designVoices)
	planOutline(planOutline)
	draftPage(draftPage)
	illustrate(illustrate)
	reviewOutline(reviewOutline)
	reviseOutline(reviseOutline)
	recast(recast)
	redraftPage(redraftPage)
	performPage(performPage)
	__end__([<p>__end__</p>]):::last
	__start__ --> understand;
	castCharacters --> designVoices;
	castCharacters --> planOutline;
	designVoices --> reviewOutline;
	draftPage --> reviewOutline;
	illustrate --> __end__;
	performPage --> __end__;
	planOutline --> draftPage;
	recast --> redraftPage;
	redraftPage --> reviewOutline;
	reviseOutline --> recast;
	understand -.-> castCharacters;
	understand -.-> askQuestion;
	askQuestion -.-> understand;
	reviewOutline -.-> performPage;
	reviewOutline -.-> illustrate;
	reviewOutline -.-> reviseOutline;
	classDef default fill:#f2f0ff,line-height:1.2;
	classDef first fill-opacity:0;
	classDef last fill:#bfb6fc;

