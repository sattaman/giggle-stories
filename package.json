{
  "name": "storytime",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel exec tsc --noEmit --pretty false",
    "typecheck:compat": "pnpm -r --parallel exec tsc6 --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm typecheck && pnpm typecheck:compat && pnpm lint",
    "spike:voice": "pnpm --filter @storytime/spike-voice start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1"
  }
}
